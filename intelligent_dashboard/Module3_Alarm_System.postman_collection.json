				{
					"name": "10. Delete Alarm (DELETE /alarms/{id})",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/alarms/1",
							"host": ["{{base_url}}"],
							"path": ["alarms", "1"]
						}
					}
				},
				{
					"name": "11. Register FCM Token (POST /alarms/fcm-token)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fcm_token\": \"sample_fcm_device_token_123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/alarms/fcm-token",
							"host": ["{{base_url}}"],
							"path": ["alarms", "fcm-token"]
						}
					}
				},
				{
					"name": "12. Scheduler Status (GET /alarms/scheduler)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/alarms/scheduler",
							"host": ["{{base_url}}"],
							"path": ["alarms", "scheduler"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://127.0.0.1:8000" },
		{ "key": "jwt_token", "value": "YOUR_JWT_ACCESS_TOKEN_HERE" }
	]
