{
	"info": {
		"_postman_id": "c3190aaf-alarm-system-v1",
		"name": "Module 3 - Alarm Scheduling System API",
		"description": "Complete Postman Collection for AI Cognitive Alarm Platform Module 3 REST APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Alarms",
			"item": [
				{
					"name": "1. Create Alarm (POST /alarms)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Morning Wakeup\",\n  \"alarm_time\": \"07:30 AM\",\n  \"alarm_type\": \"Smart Adaptive\",\n  \"repeat_days\": \"Mon,Tue,Wed,Thu,Fri\",\n  \"difficulty_level\": \"Medium\",\n  \"sound\": \"Chimes\",\n  \"vibration\": true,\n  \"challenge_required\": \"Math Puzzle\",\n  \"smart_alarm\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/alarms/",
							"host": ["{{base_url}}"],
							"path": ["alarms", ""]
						}
					}
				},
				{
					"name": "2. Get All Alarms (GET /alarms)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/alarms/",
							"host": ["{{base_url}}"],
							"path": ["alarms", ""]
						}
					}
				},
				{
					"name": "3. Get Single Alarm (GET /alarms/{id})",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/alarms/1",
							"host": ["{{base_url}}"],
							"path": ["alarms", "1"]
						}
					}
				},
				{
					"name": "4. Update Alarm (PUT /alarms/{id})",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Updated Morning Wakeup\",\n  \"alarm_time\": \"06:45 AM\",\n  \"difficulty_level\": \"Hard\",\n  \"sound\": \"Zen Bell\",\n  \"vibration\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/alarms/1",
							"host": ["{{base_url}}"],
							"path": ["alarms", "1"]
						}
					}
				},
				{
					"name": "5. Enable Alarm (PATCH /alarms/{id}/enable)",
