						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/alarms/1/enable",
							"host": ["{{base_url}}"],
							"path": ["alarms", "1", "enable"]
						}
					}
				},
				{
					"name": "6. Disable Alarm (PATCH /alarms/{id}/disable)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
