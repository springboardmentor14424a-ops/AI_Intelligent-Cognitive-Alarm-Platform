				{
					"name": "8. Get Upcoming Alarms (GET /alarms/upcoming)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/alarms/upcoming",
							"host": ["{{base_url}}"],
							"path": ["alarms", "upcoming"]
