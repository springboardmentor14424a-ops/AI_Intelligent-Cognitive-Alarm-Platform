# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:YourNewPassword123@localhost:5432/ai_alarm_db

# Security & JWT Token Configuration
SECRET_KEY=super-secret-key-change-this-in-production-123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Configuration
APP_NAME=AI Alarm Platform API
DEBUG=True
ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:5500,http://127.0.0.1:8000,*
